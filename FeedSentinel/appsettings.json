{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Watcher": {
    "OutputPath": "data",
    "Interval": "00:15:00", // Every 15 minutes, since GitHub's Atom feeds are not updated so constantly.
    "Sources": [
      {
        "Url": "https://github.com/dotnet/runtime/releases.atom",
        "Name": "DotNet Runtime Releases",
        "AllowInsecureHttp": false
      },
      {
        "Url": "https://github.com/dotnet/aspnetcore/releases.atom",
        "Name": "ASPNET Core Releases",
        "AllowInsecureHttp": false
      }
    ],
    "MaxConcurrency": 4
  }
}
