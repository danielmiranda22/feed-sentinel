<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-FeedSentinel.Worker-c9f4c78b-f82a-4c2a-9bcf-35fa3d1f015a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.14" />
  </ItemGroup>
	
	<ItemGroup>
		<!-- Runtime output (feeds + state.json): never copy to bin or publish. -->
		<Content Remove="data\**" />
	</ItemGroup>
</Project>
